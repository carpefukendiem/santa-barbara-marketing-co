# Site
NEXT_PUBLIC_SITE_URL=https://santabarbaramarketingco.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@santabarbaramarketingco.com
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_PHONE=

# Analytics (optional — scripts load only when set)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# GoHighLevel — needed for booking iframe and CRM sync; site builds without them
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=yDnbD2jIOGjslYuMeUok
NEXT_PUBLIC_GHL_CALENDAR_ID=Zzp5TRRTwptdDEdra1wZ
NEXT_PUBLIC_GHL_BOOKING_URL=https://link.rankingsb.com/widget/bookings/discovery-call-8649
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional: print-tagged leads use this pipeline stage when set
GHL_PRINT_STAGE_ID=
# Optional chat widget; omitted when unset
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# Stripe Checkout — 805 System subscriptions. Use a restricted key (rk_) in Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: pin existing Price ids. If unset, the first checkout creates them with lookup keys.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Optional: paid checkout enrolls this GHL workflow and pipeline stage
GHL_PAID_WORKFLOW_ID=
GHL_PAID_STAGE_ID=

# Fallback if GHL API is unavailable
LEAD_PROVIDER=console
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
