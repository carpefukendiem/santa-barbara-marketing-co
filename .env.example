# Site
# Canonicals use the SITE_URL constant (https://www.sbmc.io). This variable is not read.
NEXT_PUBLIC_SITE_URL=https://www.sbmc.io
NEXT_PUBLIC_CONTACT_EMAIL=info@sbmc.io
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_PHONE=

# Analytics. GA4 loads only when the measurement id is set. Otherwise every event no-ops.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# GoHighLevel — needed for booking iframe and CRM sync; site builds without them
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=yDnbD2jIOGjslYuMeUok
NEXT_PUBLIC_GHL_CALENDAR_ID=Zzp5TRRTwptdDEdra1wZ
NEXT_PUBLIC_GHL_BOOKING_URL=https://link.rankingsb.com/widget/bookings/discovery-call-8649
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Optional: print-tagged leads use this pipeline stage when set
GHL_PRINT_STAGE_ID=
# Optional chat widget; omitted when unset
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# Stripe Checkout — Local Lead Plan. Use a restricted key (rk_) in Vercel.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Core prices. If unset, checkout uses the live price ids in lib/stripe.ts.
STRIPE_PRICE_MONTHLY=price_1UYAa9CxPOau7mkvKDQqCtw0
STRIPE_PRICE_ANNUAL=price_1UYAYnCxPOau7mkv23BByTvT
# Optional add-ons. If either id is unset, that add-on is hidden and cannot be purchased.
STRIPE_PRICE_VOICE_AI_MONTHLY=price_1UaAQZCxPOau7mkvKUL0ZPBX
STRIPE_PRICE_CHAT_AI_MONTHLY=price_1UaAQbCxPOau7mkv7RVcqSJf

# Optional: paid checkout enrolls this GHL workflow and pipeline stage
GHL_PAID_WORKFLOW_ID=
GHL_PAID_STAGE_ID=

# Fallback if GHL API is unavailable
LEAD_PROVIDER=console
LEAD_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
